<% layout('layout/boilerplate') %>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card border-0 shadow-sm rounded-4 mb-4">
      <div class="card-header bg-primary text-white py-3 px-4 rounded-top-4 d-flex justify-content-between align-items-center">
        <div>
          <h5 class="mb-0 fw-bold">Laundry Readiness Prediction</h5>
          <small class="opacity-75">
            Student: <%= formData.Student_ID %> &bull; Token: <%= formData.Token_ID %>
          </small>
        </div>
        <a href="/" class="btn btn-sm btn-light fw-semibold">← New Prediction</a>
      </div>

      <div class="card-body p-4">
        <div class="row g-3 mb-4">
          <div class="col-md-4">
            <div class="p-3 bg-light rounded-3 border h-100">
              <div class="text-muted small fw-medium">Expected Collection Date</div>
              <div class="fs-5 fw-bold text-dark mt-1"><%= prediction.expectedDate %></div>
              <small class="text-muted">
                <%= prediction.usedFallbackExpected
                  ? `Estimated from ${stats.avgExpectedDays}-day historical average`
                  : 'Date given by laundry counter' %>
              </small>
            </div>
          </div>

          <div class="col-md-4">
            <div class="p-3 bg-warning-subtle rounded-3 border border-warning-subtle h-100">
              <div class="text-warning-emphasis small fw-medium">Predicted Ready Date</div>
              <div class="fs-5 fw-bold text-dark mt-1">
                <%= prediction.predictedReadyDate %> (<%= prediction.predictedReadyWeekday %>)
              </div>
              <small class="text-muted">
                Expected + <%= stats.percentileDelayDays %> day(s) (<%= Math.round(stats.delayPercentile * 100) %>th percentile delay)
              </small>
            </div>
          </div>

          <div class="col-md-4">
            <div class="p-3 bg-success-subtle rounded-3 border border-success-subtle h-100">
              <div class="text-success-emphasis small fw-medium">Recommended Visit Date</div>
              <div class="fs-5 fw-bold text-success mt-1">
                <%= prediction.recommendedVisitDate %> (<%= prediction.recommendedVisitWeekday %>)
              </div>
              <small class="text-muted">
                <% if (prediction.skippedClosedDays.length > 0) { %>
                  Skipped closed weekday(s): <%= prediction.skippedClosedDays.join(", ") %>
                <% } else { %>
                  No closed-day conflict on this date
                <% } %>
              </small>
            </div>
          </div>
        </div>

        <h6 class="fw-bold mb-3">Historical Statistics from <code>data.csv</code></h6>
        <div class="table-responsive">
          <table class="table table-bordered small mb-0">
            <tbody>
              <tr>
                <th class="bg-light w-50">Valid Historical Orders Analysed</th>
                <td><%= stats.validRowCount %> rows</td>
              </tr>
              <tr>
                <th class="bg-light">Share of Orders That Were Late</th>
                <td>
                  <%= stats.lateOrdersCount %> of <%= stats.validRowCount %> (<%= stats.latePercentage %>%)
                </td>
              </tr>
              <tr>
                <th class="bg-light">Delay Used (<%= Math.round(stats.delayPercentile * 100) %>th Percentile, Rounded Up)</th>
                <td>+<%= stats.percentileDelayDays %> day(s)</td>
              </tr>
              <tr>
                <th class="bg-light">Average Actual Processing Time</th>
                <td><%= stats.avgProcessingDays %> days</td>
              </tr>
              <tr>
                <th class="bg-light">Weekdays with <code>Found_Shop_Closed = Yes</code> in Data</th>
                <td>
                  <% if (stats.closedWeekdays.length > 0) { %>
                    <%= stats.closedWeekdays.join(", ") %>
                  <% } else { %>
                    no closed day found in the data
                  <% } %>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
