<% layout('layout/boilerplate') %>

<% if (saved) { %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    New laundry outcome has been appended to <code>data.csv</code>.
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<% if (skippedRows && skippedRows.length > 0) { %>
  <div class="alert alert-warning border-warning shadow-sm rounded-3 mb-4">
    <h6 class="fw-bold mb-2">
      Skipped <%= skippedRows.length %> Invalid Row(s) in <code><%= sourceLabel %></code>
    </h6>
    <ul class="mb-0 small">
      <% skippedRows.forEach((item) => { %>
        <li>
          <strong>Row <%= item.rowNumber %>:</strong> <%= item.reason %>
          <code class="ms-1 text-dark">(<%= item.raw %>)</code>
        </li>
      <% }) %>
    </ul>
  </div>
<% } %>

<div class="card border-0 shadow-sm rounded-4">
  <div class="card-header bg-white border-bottom py-3 px-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div>
      <h5 class="mb-0 fw-bold text-primary">Recorded Laundry Dataset (<code><%= sourceLabel %></code>)</h5>
      <p class="text-muted small mb-0">
        Valid rows loaded: <strong><%= records.length %></strong> &bull; Skipped rows: <strong><%= skippedRows.length %></strong>
      </p>
    </div>
    <div class="d-flex align-items-center gap-2">
      <% if (sourceLabel === 'data.csv') { %>
        <a href="/records?source=bad-rows" class="btn btn-sm btn-outline-warning fw-semibold">
          Test Bad Rows (<code>test/bad-rows.tsv</code>)
        </a>
      <% } else { %>
        <a href="/records" class="btn btn-sm btn-outline-secondary fw-semibold">
          Back to <code>data.csv</code>
        </a>
      <% } %>
      <a href="/outcome" class="btn btn-sm btn-outline-success fw-semibold">+ Record Outcome</a>
      <a href="/" class="btn btn-sm btn-primary fw-semibold">Predict Readiness</a>
    </div>
  </div>

  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0 small">
        <thead class="table-light">
          <tr>
            <th class="ps-4">Student ID</th>
            <th>Token ID</th>
            <th>Submitted</th>
            <th>Expected</th>
            <th>Actual Ready</th>
            <th>Collected</th>
            <th class="text-center">Delay (Days)</th>
            <th class="text-center">Visits</th>
            <th>Shop Closed?</th>
            <th>Ready on Visit?</th>
            <th class="pe-4">Notes</th>
          </tr>
        </thead>
        <tbody>
          <% if (records && records.length > 0) { %>
            <% records.forEach((row) => { %>
              <tr>
                <td class="ps-4 fw-semibold"><%= row.Student_ID %></td>
                <td><span class="badge bg-secondary-subtle text-secondary"><%= row.Token_ID %></span></td>
                <td><%= row.Submission_Date %></td>
                <td><%= row.Expected_Collection_Date %></td>
                <td><%= row.Actual_Ready_Date %></td>
                <td><%= row.Actual_Collection_Date %></td>
                <td class="text-center">
                  <span class="badge <%= row.delayDays > 0 ? 'bg-warning-subtle text-warning-emphasis' : 'bg-success-subtle text-success' %>">
                    <%= row.delayDays > 0 ? `+${row.delayDays}` : row.delayDays %>
                  </span>
                </td>
                <td class="text-center"><%= row.Counter_Visits %></td>
                <td>
                  <span class="badge <%= row.Found_Shop_Closed === 'Yes' ? 'bg-danger-subtle text-danger' : 'bg-light text-dark' %>">
                    <%= row.Found_Shop_Closed %>
                  </span>
                </td>
                <td>
                  <span class="badge <%= row.Was_Ready_When_Visited === 'Yes' ? 'bg-success-subtle text-success' : 'bg-warning-subtle text-warning-emphasis' %>">
                    <%= row.Was_Ready_When_Visited %>
                  </span>
                </td>
                <td class="pe-4 text-muted"><%= row.Notes || '—' %></td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="11" class="text-center text-muted py-4">No valid records found.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
