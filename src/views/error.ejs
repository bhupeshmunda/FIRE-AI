<% layout('layout/boilerplate') %>

<div class="row justify-content-center">
  <div class="col-lg-7">
    <div class="card border-danger shadow-sm rounded-4">
      <div class="card-header bg-danger text-white py-3 px-4 rounded-top-4">
        <h5 class="mb-0 fw-bold"><%= heading || 'Error' %></h5>
      </div>
      <div class="card-body p-4">
        <p class="mb-3"><%= message %></p>

        <% if (skippedRows && skippedRows.length > 0) { %>
          <div class="alert alert-warning small">
            <strong>Skipped rows in file:</strong>
            <ul class="mb-0 mt-1">
              <% skippedRows.forEach((item) => { %>
                <li>Row <%= item.rowNumber %>: <%= item.reason %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <div class="d-flex gap-2">
          <a href="/" class="btn btn-outline-primary btn-sm fw-semibold">← Back to Home</a>
          <a href="/records" class="btn btn-outline-secondary btn-sm fw-semibold">View Recorded Data</a>
        </div>
      </div>
    </div>
  </div>
</div>
