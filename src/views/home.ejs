<% layout('layout/boilerplate') %>

<div class="row justify-content-center">
  <div class="col-lg-6">
    <div class="card border-0 shadow-sm rounded-4">
      <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
        <div>
          <h5 class="mb-1 fw-bold text-primary">Predict Laundry Readiness</h5>
          <p class="text-muted small mb-0">
            Enter your laundry submission details to estimate when your clothes will be ready.
          </p>
        </div>
      </div>

      <div class="card-body p-4">
        <form action="/prediction" method="POST">
          <div class="row g-3">
            <div class="col-md-6">
              <label for="Student_ID" class="form-label fw-semibold small">Student ID</label>
              <input
                type="text"
                class="form-control"
                id="Student_ID"
                name="Student_ID"
                placeholder="e.g., S021"
                required
              />
            </div>

            <div class="col-md-6">
              <label for="Token_ID" class="form-label fw-semibold small">Token ID</label>
              <input
                type="text"
                class="form-control"
                id="Token_ID"
                name="Token_ID"
                placeholder="e.g., LT1021"
                required
              />
            </div>

            <div class="col-md-6">
              <label for="Submission_Date" class="form-label fw-semibold small">Submission Date</label>
              <input
                type="date"
                class="form-control"
                id="Submission_Date"
                name="Submission_Date"
                required
              />
            </div>

            <div class="col-md-6">
              <label for="Expected_Collection_Date" class="form-label fw-semibold small">
                Expected Collection Date <span class="text-muted fw-normal">(Optional)</span>
              </label>
              <input
                type="date"
                class="form-control"
                id="Expected_Collection_Date"
                name="Expected_Collection_Date"
              />
              <div class="form-text small">Leave blank if the shop did not give a date.</div>
            </div>

            <div class="col-12 pt-2">
              <button type="submit" class="btn btn-primary w-100 fw-semibold py-2">
                Predict Ready Date
              </button>
            </div>
          </div>
        </form>
      </div>

      <div class="card-footer bg-light border-top py-3 px-4 d-flex justify-content-between align-items-center small">
        <span class="text-muted">Already collected your clothes?</span>
        <a href="/outcome" class="fw-semibold text-decoration-none">Record Real Outcome →</a>
      </div>
    </div>
  </div>
</div>
